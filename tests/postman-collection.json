            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Maria\",\n  \"apelido\": \"Santos\",\n  \"idCurso\": 2,\n  \"anoCurricular\": 1,\n  \"idade\": 19\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "// guarda o id do aluno criado (id no JSON-server, _id no MongoDB)",
                  "const a = pm.response.json();",
                  "pm.collectionVariables.set('alunoId', a._id || a.id);"
                ]
              }
            }
          ]
