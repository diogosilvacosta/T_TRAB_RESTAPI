				{
					"name": "Listar alunos",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "localhost:3000/alunos",
							"host": ["localhost"],
							"port": "3000",
							"path": ["alunos"]
						}
					},
					"response": []
				},
				{
					"name": "Obter aluno por ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "localhost:3000/alunos/1",
							"host": ["localhost"],
							"port": "3000",
							"path": ["alunos", "1"]
						}
					},
					"response": []
				},
				{
					"name": "Criar aluno",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 201', () => pm.response.to.have.status(201));",
									"pm.test('Tem nome', () => { const d = pm.response.json(); pm.expect(d.nome).to.be.a('string'); });"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nome\": \"Maria\",\n  \"apelido\": \"Santos\",\n  \"idCurso\": 2,\n  \"anoCurricular\": 1,\n  \"idade\": 19\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "localhost:3000/alunos",
							"host": ["localhost"],
							"port": "3000",
							"path": ["alunos"]
						}
					},
					"response": []
				},
				{
					"name": "Atualizar aluno (PUT)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"pm.test('Nome atualizado', () => { const d = pm.response.json(); pm.expect(d.nome).to.equal('Maria'); });"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "PUT",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nome\": \"Maria\",\n  \"apelido\": \"Santos\",\n  \"idCurso\": 2,\n  \"anoCurricular\": 2,\n  \"idade\": 20\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "localhost:3000/alunos/1",
