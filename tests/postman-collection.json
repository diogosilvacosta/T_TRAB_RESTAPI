						"url": {
							"raw": "localhost:3000/alunos/1",
							"host": ["localhost"],
							"port": "3000",
							"path": ["alunos", "1"]
						}
					},
					"response": []
				},
				{
					"name": "Apagar aluno",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200', () => pm.response.to.have.status(200));"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "DELETE",
						"header": [],
